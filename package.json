{
  "name": "folioduet",
  "private": true,
  "version": "0.1.0",
  "description": "A calmer PDF reader with word-aligned listening and private cloud sync",
  "repository": {
    "type": "git",
    "url": "https://github.com/dion-labs/folioduet.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:boxie-rules": "npx --yes firebase-tools@15.28.2 emulators:exec --project demo-dionlabs-boxie --only firestore \"vitest run --config firebase-tests/vitest.config.ts\"",
    "preview": "vite preview",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@firecrawl/anydoc-wasm": "^0.1.7",
    "firebase": "^12.17.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.10",
    "pdfjs-dist": "^4.4.168",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
  }
}
