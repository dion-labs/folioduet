# Copy to `.env.local` for local development (gitignored).
# Official Dion Labs production values are injected via Cloudflare Pages env vars — not committed.

# --- Optional local Node TTS/sync proxy (npm run dev) ---
# Server-only. Never commit real values. Inworld is BYOK-only for the static SPA.
INWORLD_API_KEY=
FISH_AUDIO_API_KEY=

PAGEECHO_SERVER_HOST=127.0.0.1
PAGEECHO_SERVER_PORT=8787
PAGEECHO_DATA_DIR=./data

# --- Firebase (client) ---
# Create your own Firebase web app, then paste the config here.
# Leave PROJECT_ID empty to fall back to the local Node sync server (single-user).
# Firebase web API keys are not secret; security comes from Auth + Firestore rules.
VITE_FIREBASE_API_KEY=
# Must be <project>.firebaseapp.com (or .web.app) — not your custom Pages domain.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Only set if you proxy /__/auth on the production host (e.g. Cloudflare Worker).
# Vite dev already proxies — leave unset for Cloudflare Pages Git builds.
# VITE_FIREBASE_AUTH_PROXY=true

# Intentionally public sponsor TTS key while Fish Audio remains free.
# On Cloudflare Pages this is used by the /api/tts Pages Function (and optionally baked into the client for “ready” UI).
# Leave empty to require in-app BYOK.
VITE_FISH_AUDIO_SPONSOR_KEY=

# Optional override for the Settings → Fish “get a key” link (has a Dion Labs default).
# VITE_FISH_AUDIO_REFERRAL_URL=https://fish.audio/?aff=…

# Homepage footer links (optional overrides).
VITE_GITHUB_REPO_URL=https://github.com/dion-labs/pageecho
VITE_GITHUB_SPONSORS_URL=https://github.com/sponsors/dion-labs
