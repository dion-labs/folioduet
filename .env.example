# Server-only Inworld Basic credential. Include or omit the "Basic " prefix.
INWORLD_API_KEY=

# Server-only Fish Audio API credential.
FISH_AUDIO_API_KEY=

# Optional server configuration.
# Dev (`npm run dev`) defaults to 0.0.0.0:5173 so Tailscale/LAN clients can connect.
# Production (`npm start`) defaults to 127.0.0.1:8787 unless you override HOST here.
PAGEECHO_SERVER_HOST=127.0.0.1
PAGEECHO_SERVER_PORT=8787
PAGEECHO_DATA_DIR=./data
